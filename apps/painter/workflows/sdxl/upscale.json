{
  "_comment": "Upscale con modelo ESRGAN/OmniSR. Placeholders: {{image_b64}} {{model_name}}. No requiere checkpoint ni sampler — es post-proceso puro. Requiere: ETN_LoadImageBase64",
  "1": {
    "class_type": "ETN_LoadImageBase64",
    "inputs": {
      "image": "{{image_b64}}"
    }
  },
  "2": {
    "class_type": "UpscaleModelLoader",
    "inputs": {
      "model_name": "{{model_name}}"
    }
  },
  "3": {
    "class_type": "ImageUpscaleWithModel",
    "inputs": {
      "upscale_model": ["2", 0],
      "image":         ["1", 0]
    }
  },
  "4": {
    "class_type": "SaveImage",
    "inputs": {
      "images":          ["3", 0],
      "filename_prefix": "painter_upscale"
    }
  }
}

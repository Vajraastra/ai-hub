{
  "_comment": "ADetailer — un detector a la vez. Placeholders: {{checkpoint}} {{image_b64}} {{prompt}} {{negative_prompt}} {{detector_model}} {{seed}} {{steps}} {{cfg}} {{sampler}} {{scheduler}} {{denoise}} {{guide_size}} {{bbox_threshold}} {{bbox_dilation}}",
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "{{checkpoint}}"
    }
  },
  "2": {
    "class_type": "ETN_LoadImageBase64",
    "inputs": {
      "image": "{{image_b64}}"
    }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{prompt}}",
      "clip": ["1", 1]
    }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{negative_prompt}}",
      "clip": ["1", 1]
    }
  },
  "5": {
    "class_type": "UltralyticsDetectorProvider",
    "inputs": {
      "model_name": "{{detector_model}}"
    }
  },
  "6": {
    "class_type": "FaceDetailer",
    "inputs": {
      "image":          ["2", 0],
      "model":          ["1", 0],
      "clip":           ["1", 1],
      "vae":            ["1", 2],
      "positive":       ["3", 0],
      "negative":       ["4", 0],
      "bbox_detector":  ["5", 0],
      "guide_size":     "{{guide_size}}",
      "guide_size_for": true,
      "max_size":       1024,
      "seed":           "{{seed}}",
      "steps":          "{{steps}}",
      "cfg":            "{{cfg}}",
      "sampler_name":   "{{sampler}}",
      "scheduler":      "{{scheduler}}",
      "denoise":        "{{denoise}}",
      "feather":        5,
      "noise_mask":     true,
      "force_inpaint":  true,
      "bbox_threshold": "{{bbox_threshold}}",
      "bbox_dilation":  "{{bbox_dilation}}",
      "bbox_crop_factor": 3.0,
      "sam_detection_hint": "center-1",
      "sam_dilation":   0,
      "sam_threshold":  0.93,
      "sam_bbox_expansion": 0,
      "sam_mask_hint_threshold": 0.7,
      "sam_mask_hint_use_negative": "False",
      "drop_size":      10,
      "wildcard":       "",
      "cycle":          1
    }
  },
  "7": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["6", 0],
      "filename_prefix": "painter_adetailer"
    }
  }
}

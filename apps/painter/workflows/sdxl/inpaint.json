{
  "_comment": "Inpaint mejorado con comfyui-inpaint-nodes (Fooocus). Placeholders: {{checkpoint}} {{inpaint_model}} {{prompt}} {{negative_prompt}} {{image_b64}} {{mask_b64}} {{seed}} {{steps}} {{cfg}} {{sampler}} {{scheduler}} {{denoise}}. Requiere: ETN_LoadImageBase64, ETN_LoadMaskBase64, INPAINT_LoadInpaintModel, INPAINT_InpaintWithModel",
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "{{checkpoint}}"
    }
  },
  "2": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{prompt}}",
      "clip": ["1", 1]
    }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{negative_prompt}}",
      "clip": ["1", 1]
    }
  },
  "4": {
    "class_type": "ETN_LoadImageBase64",
    "inputs": {
      "image": "{{image_b64}}"
    }
  },
  "5": {
    "class_type": "ETN_LoadMaskBase64",
    "inputs": {
      "mask": "{{mask_b64}}"
    }
  },
  "6": {
    "class_type": "INPAINT_LoadInpaintModel",
    "inputs": {
      "model_name": "{{inpaint_model}}"
    }
  },
  "7": {
    "class_type": "INPAINT_InpaintWithModel",
    "inputs": {
      "inpaint_model": ["6", 0],
      "image": ["4", 0],
      "mask": ["5", 0],
      "noise_mask": true,
      "falloff": 4,
      "min_denoise": 0.0,
      "max_denoise": "{{denoise}}"
    }
  },
  "8": {
    "class_type": "VAEEncodeForInpaint",
    "inputs": {
      "pixels": ["7", 0],
      "vae": ["1", 2],
      "mask": ["5", 0],
      "grow_mask_by": 6
    }
  },
  "9": {
    "class_type": "KSampler",
    "inputs": {
      "seed": "{{seed}}",
      "steps": "{{steps}}",
      "cfg": "{{cfg}}",
      "sampler_name": "{{sampler}}",
      "scheduler": "{{scheduler}}",
      "denoise": "{{denoise}}",
      "model": ["1", 0],
      "positive": ["2", 0],
      "negative": ["3", 0],
      "latent_image": ["8", 0]
    }
  },
  "10": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["9", 0],
      "vae": ["1", 2]
    }
  },
  "11": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["10", 0],
      "filename_prefix": "painter_inpaint"
    }
  }
}

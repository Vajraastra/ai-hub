{
    "apps": {
        "sd-webui-forge-neo": {
            "id": "sd-webui-forge-neo",
            "name": "Stable Diffusion WebUI Forge Neo",
            "description": "The good ol' Forge WebUI, now updated with new features",
            "repo": "https://github.com/Haoming02/sd-webui-forge-classic",
            "branch": "neo",
            "python_version": "3.12",
            "shared_runtime": "py312-torch",
            "python_layer": "overlay",
            "use_uv": true,
            "install_deps": true,
            "launch_type": "python",
            "launch_script": "launch.py",
            "launch_script_win": "webui-user.bat",
            "launch_args": [
                "--skip-prepare-environment",
                "--skip-install",
                "--skip-python-version-check",
                "--skip-version-check"
            ],
            "pre_install_commands": [
                "{uv} pip install torch=={torch_version} torchvision=={torchvision_version} torchaudio=={torchaudio_version} --index-url https://download.pytorch.org/whl/{cuda_tag}"
            ],
            "pip_extra_packages": [
                "aiofiles==23.2.1",
                "ffmpy==1.0.0",
                "gradio-client==1.2.0",
                "importlib-resources==6.5.2",
                "jinja2==3.1.6",
                "markupsafe==2.1.5",
                "orjson==3.12.0",
                "pandas==2.3.3",
                "pydub==0.25.1",
                "python-multipart==0.0.32",
                "ruff==0.16.8",
                "semantic-version==2.10.0",
                "tomlkit==0.12.0",
                "typer==0.21.0",
                "uvicorn==0.53.0",
                "websockets==12.0"
            ],
            "pip_no_deps_packages": [
                "gradio==4.40.0",
                "gradio_rangeslider==0.0.8"
            ],
            "model_map": {
                "checkpoints": { "flag": "--ckpt-dirs", "type": "append" },
                "loras": { "flag": "--lora-dirs", "type": "append" },
                "vae": { "flag": "--vae-dirs", "type": "append" },
                "text_encoders": { "flag": "--text-encoder-dirs", "type": "append" },
                "embeddings": { "flag": "--embeddings-dir", "type": "replace" },
                "upscalers": { "flag": "--esrgan-models-path", "type": "replace" }
            },
            "output_map": {
                "method": "config_json",
                "version_uid_source": "modules/launch_utils.py",
                "settings": {
                    "outdir_txt2img_samples": "txt2img",
                    "outdir_img2img_samples": "img2img",
                    "outdir_extras_samples": "extras",
                    "outdir_txt2img_grids": "grids/txt2img",
                    "outdir_img2img_grids": "grids/img2img",
                    "outdir_save": "saved",
                    "outdir_videos": "videos"
                }
            },
            "config_path_lists": [
                "forge_additional_modules",
                "forge_additional_modules_sd"
            ],
            "post_install_patches": [
                {
                    "file": "modules/sd_models.py",
                    "find": "        name = name.strip(\"/\").strip(\"\\\\\")",
                    "replace": "        name = name.strip(\"/\").strip(\"\\\\\")\n        if not name:\n            name = os.path.basename(filename)",
                    "critical": true
                }
            ],
            "cuda_env_vars": { "torch_index": "TORCH_INDEX_URL", "torch_command": "TORCH_COMMAND" },
            "default_port": 7860,
            "auto_open_browser": true,
            "extra_args": []
        },
        "ai-toolkit": {
            "id": "ai-toolkit",
            "name": "AI Toolkit (Ostris)",
            "description": "LoRA trainer for Flux, SDXL, and SD models",
            "repo": "https://github.com/ostris/ai-toolkit",
            "branch": "main",
            "python_version": "3.12",
            "shared_runtime": "py312-torch",
            "python_layer": "overlay",
            "python_hide_packages": ["mediapipe"],
            "use_uv": true,
            "install_deps": true,
            "launch_type": "npm",
            "launch_script": "build_and_start",
            "launch_subdir": "ui",
            "config_dir": "config",
            "config_examples_dir": "config/examples",
            "pre_install_commands": [
                "{uv} pip install torch=={torch_version} torchvision=={torchvision_version} torchaudio=={torchaudio_version} --index-url https://download.pytorch.org/whl/{cuda_tag}"
            ],
            "pip_overrides": [
                "scipy==1.18.0",
                "numpy==2.4.4",
                "opencv-python==5.0.0.93",
                "opencv-python-headless==5.0.0.93",
                "gradio==5.50.0"
            ],
            "output_map": { "method": "none" },
            "cuda_env_vars": { "torch_index": "PIP_EXTRA_INDEX_URL" },
            "default_port": 8675,
            "auto_open_browser": true,
            "extra_args": []
        },
        "comfyui": {
            "id": "comfyui",
            "name": "ComfyUI",
            "description": "The most powerful and modular stable diffusion GUI with a node/graph interface.",
            "repo": "https://github.com/comfyanonymous/ComfyUI.git",
            "branch": "master",
            "python_version": "3.12",
            "use_uv": true,
            "shared_runtime": "py312-torch",
            "python_layer": "base",
            "install_deps": true,
            "install_comfy_nodes": true,
            "launch_type": "python",
            "launch_script": "main.py",
            "pre_install_commands": [
                "{uv} pip install torch=={torch_version} torchvision=={torchvision_version} torchaudio=={torchaudio_version} --index-url https://download.pytorch.org/whl/{cuda_tag}"
            ],
            "model_map": {
                "method": "yaml",
                "filename": "extra_model_paths.yaml",
                "mappings": {
                    "checkpoints": "checkpoints",
                    "loras": "loras",
                    "vae": "vae",
                    "vae_approx": "vae_approx",
                    "controlnet": "controlnet",
                    "embeddings": "embeddings",
                    "upscale_models": "upscale_models",
                    "clip_vision": "clip_vision",
                    "ipadapter": "ipadapter",
                    "diffusion_models": "diffusion_models",
                    "clip": "clip",
                    "style_models": "style_models",
                    "hypernetworks": "hypernetworks",
                    "ultralytics": "ultralytics",
                    "inpaint": "inpaint",
                    "model_patches": "model_patches",
                    "gligen": "gligen",
                    "sams": "sams",
                    "photomaker": "photomaker",
                    "classifiers": "classifiers"
                },
                "symlinks": {
                    "ultralytics": "ultralytics",
                    "style_models": "style_models"
                }
            },
            "output_map": { "method": "cli", "args": ["--output-directory"] },
            "cuda_env_vars": { "torch_index": "PIP_EXTRA_INDEX_URL" },
            "default_port": 8188,
            "auto_open_browser": true,
            "extra_args": ["--use-pytorch-cross-attention"]
        },
        "anima-standalone-trainer": {
            "id": "anima-standalone-trainer",
            "name": "Anima Standalone Trainer",
            "description": "Trainer de LoRA para Anima con UI web (Node.js + sd-scripts embebido). Control completo de hiperparámetros: lr, alpha, scheduler, flow_shift, resume.",
            "repo": "https://github.com/gazingstars123/Anima-Standalone-Trainer",
            "branch": "main",
            "python_version": "3.12",
            "use_uv": true,
            "shared_runtime": "py312-torch",
            "python_layer": "overlay",
            "install_deps": true,
            "single_gpu_preference": true,
            "post_install_patches": [
                {
                    "file": "training-ui/server.js",
                    "find": "    let accelerateFlags = '';",
                    "replace": "    let accelerateFlags = `--num_processes 1 --mixed_precision ${mixedPrec}`;",
                    "critical": true
                },
                {
                    "file": "training-ui/server.js",
                    "find": "            accelerateFlags = `--mixed_precision ${mixedPrec}`;",
                    "replace": "            accelerateFlags = `--num_processes 1 --mixed_precision ${mixedPrec}`;",
                    "critical": true
                }
            ],
            "launch_type": "npm",
            "launch_script": "start",
            "launch_subdir": "training-ui",
            "post_install_py": "scripts/install_standalone_trainer.py",
            "pre_install_commands": [
                "{uv} pip install torch=={torch_version} torchvision=={torchvision_version} torchaudio=={torchaudio_version} --index-url https://download.pytorch.org/whl/{cuda_tag}"
            ],
            "model_map": {},
            "output_map": { "method": "none" },
            "default_port": 3000,
            "auto_open_browser": false,
            "extra_args": []
        }
    },
    "utilities": {
        "model-vault": {
            "id": "model-vault",
            "name": "Model Vault",
            "description": "Organizador y gestor de modelos/LoRAs con integración a Civitai. Pre-instalado con el Hub.",
            "type": "utility",
            "is_internal": true,
            "is_utility": true,
            "launch_type": "web",
            "web_path": "/vault",
            "icon": "📦"
        },
        "painter": {
            "id": "painter",
            "name": "AI Painter",
            "description": "Editor de imágenes IA con ComfyUI. Generación txt2img/inpaint/outpaint/upscale, ControlNet, ADetailer y regional conditioning.",
            "type": "utility",
            "is_internal": true,
            "is_utility": true,
            "launch_type": "web",
            "web_path": "/painter",
            "icon": "🎨"
        }
    }
}
